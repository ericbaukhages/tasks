{
  "name": "tasks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=web",
    "test": "npm run test --workspace=server --workspace=web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo server/dist server/*.tsbuildinfo web/dist web/dist-test data *.tsbuildinfo web/*.tsbuildinfo web/vite.config.js web/vite.config.d.ts",
    "serve": "npm run serve --workspace=server",
    "mcp": "npm run mcp --workspace=server",
    "dev-web": "npm run dev --workspace=web"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  }
}
